# Copy this to .env and fill in your values
# Backend will work without Supabase using demo credentials and in-memory storage

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-key-here

# Groq API for image analysis (get free key from https://console.groq.com)
# Leave blank to use mock image scoring (no API key needed during development)
GROQ_API_KEY=

# Change this to a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
